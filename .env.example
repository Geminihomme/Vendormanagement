# ============================================
# VENDOR MANAGEMENT PLATFORM - PRODUCTION CONFIG
# ============================================
# Copy this file to .env and fill in your real values:
#   cp .env.example .env
#
# NEVER commit the .env file to git! It contains secrets.
# The .gitignore already prevents this, but be careful.

# --- DATABASE ---
# The username and password for your PostgreSQL database.
# Pick a strong password! (at least 20 characters, mix of letters/numbers/symbols)
DB_USER=vendorapp
DB_PASSWORD=CHANGE_ME_to_a_strong_password_here
DB_NAME=vendormanagement

# --- SECURITY ---
# JWT Secret Key: Used to sign login tokens. Must be a long random string.
# Generate one by running this command in your terminal:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# Or use: openssl rand -hex 32
JWT_SECRET_KEY=CHANGE_ME_generate_with_command_above

# --- CORS (Security) ---
# Which frontend URLs are allowed to call the API.
# Set this to your actual frontend domain (with https://).
# Example: https://vendorapp.yourdomain.com
# For multiple domains, separate with commas (no spaces).
CORS_ORIGINS=https://your-frontend-domain.com

# --- FRONTEND ---
# Where the frontend should send API requests.
# If frontend and backend are on different domains/ports, set this.
# If they're on the same domain, leave empty.
# Example: https://api.yourdomain.com
REACT_APP_API_URL=https://your-backend-domain.com
